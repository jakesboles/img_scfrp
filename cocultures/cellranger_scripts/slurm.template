#!/usr/bin/env bash
#
# =============================================================================
# Martian/Cell Ranger SLURM job template - img_scfrp / coculture pools
# =============================================================================
#
# Used via `cellranger multi --jobmode=<path to this file>` (or
# `cellranger testrun --jobmode=...` for validation). Martian substitutes the
# __MRO_*__ placeholders below and submits one sbatch job per pipeline stage
# chunk to this account/partition. Do not remove any of the placeholders or
# Martian may not run properly.
#
# Identical to monocultures/cellranger_scripts/slurm.template -- copied
# rather than shared, matching this project's existing convention of one
# full, self-contained cellranger_scripts/ tree per arm. If the
# account/partition or per-stage resource caps ever need to change, update
# both copies together.
#
#SBATCH -J __MRO_JOB_NAME__
#SBATCH --account=b1042
#SBATCH --partition=genomics
#SBATCH --export=ALL
#SBATCH --nodes=1
#SBATCH --ntasks=1 --cpus-per-task=__MRO_THREADS__
#SBATCH --signal=2
#SBATCH --no-requeue
#SBATCH --time=24:00:00
#SBATCH --mem=__MRO_MEM_GB__G
#SBATCH -o __MRO_STDOUT__
#SBATCH -e __MRO_STDERR__

__MRO_CMD__
