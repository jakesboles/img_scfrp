        counts_bc_order          = self.report_mol_inputs,
        feature_reference_binary = self.slfe_feature_reference,
        *                        = self,
    )

    call SUBSAMPLE_READS(
        molecule_info = WRITE_MOLECULE_INFO.single_mol_info.h5_file,
